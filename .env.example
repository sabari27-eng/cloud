# ==============================================================================
# Cloud-Based Assignment Submission and Tracking System (CSM) Environment Config
# ==============================================================================

# Flask Secret Key for session signing
SECRET_KEY=change-this-in-production-to-a-cryptographically-secure-random-string

# Database Configuration (Defaults to SQLite for local development)
# For AWS RDS MySQL: mysql+pymysql://<user>:<password>@<rds-endpoint>:3306/<database>
DATABASE_URL=sqlite:///csm_database.sqlite3

# AWS S3 Storage Settings (Future Cloud Deployment)
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=csm-assignment-submissions-bucket

# Email Settings (AWS SES / SMTP for Teacher Account Activation & Password Reset)
MAIL_SERVER=email-smtp.us-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_DEFAULT_SENDER=no-reply@college.edu
